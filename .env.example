# Database: SQLite file (demo) or PostgreSQL (use a read-only role).
DATABASE_URL=sqlite:///data/demo.db
# DATABASE_URL=postgresql://analyst_ro:analyst_ro@localhost:5432/shop

# Schemas exposed to the assistant (PostgreSQL only; comma separated).
ALLOWED_SCHEMAS=public

# Safety policy: masking rules, blocked tables/columns/functions, rate limits, saved queries.
POLICY_PATH=config/policy.yaml

# Query limits.
DEFAULT_LIMIT=100
MAX_ROWS=1000
MAX_RESULT_BYTES=262144
STATEMENT_TIMEOUT_MS=5000

# JSONL audit log of every tool call (empty to disable).
AUDIT_LOG_PATH=logs/audit.jsonl

# Streamable HTTP transport.
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Bearer token required on /mcp when set.
MCP_HTTP_TOKEN=
# Extra Host header values accepted by DNS-rebinding protection (comma separated, e.g. "my-app.onrender.com").
MCP_ALLOWED_HOSTS=

LOG_LEVEL=INFO
